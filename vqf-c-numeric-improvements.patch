+static void matrix3JosephCovarianceUpdate(const vqf_real_t P[9], const vqf_real_t K[9], const vqf_real_t R[9],
+                                          const vqf_real_t w[3], vqf_real_t out[9])
+{
+    vqf_real_t A[9];
+    vqf_real_t tmp[9];
+
+    matrix3Multiply(K, R, A); // A = K R
+    for (size_t i = 0; i < 9; i++) {
+        A[i] = -A[i];
+    }
+    A[0] += 1.0f;
+    A[4] += 1.0f;
+    A[8] += 1.0f; // A = I - K R
+
+    for (size_t row = 0; row < 3; row++) {
+        for (size_t col = row; col < 3; col++) {
+            vqf_real_t value = 0.0f;
+
+            for (size_t m = 0; m < 3; m++) {
+                vqf_real_t AP = A[3*row + 0]*P[0*3 + m]
+                               + A[3*row + 1]*P[1*3 + m]
+                               + A[3*row + 2]*P[2*3 + m];
+                value += AP * A[3*col + m];
+            }
+
+            value += K[3*row + 0]*w[0]*K[3*col + 0]
+                   + K[3*row + 1]*w[1]*K[3*col + 1]
+                   + K[3*row + 2]*w[2]*K[3*col + 2];
+
+            tmp[3*row + col] = value;
+            tmp[3*col + row] = value;
+        }
+    }
+
+    memcpy(out, tmp, sizeof(tmp));
+}
