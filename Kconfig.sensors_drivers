config SENSOR_IMU_DRIVERS_MINIMAL
	bool "Compile only selected IMU drivers"
	default n
	help
	  When disabled (default), every SENSOR_DRV_* IMU option defaults to y.
	  When enabled, each IMU SENSOR_DRV_* defaults to n; enable the BOM
	  drivers in the board *_defconfig.

config SENSOR_MAG_DRIVERS_MINIMAL
	bool "Compile only selected magnetometer drivers"
	default n
	help
	  Same as SENSOR_IMU_DRIVERS_MINIMAL but for magnetometer drivers.
	  Mag may be entirely disabled (mag-less boards).

