#include "xiao_nrf54lm20a-pinctrl.dtsi"
#include <zephyr/dt-bindings/regulator/npm13xx.h>

/ {
	leds {
		compatible = "gpio-leds";

		blue_led: led_0 {
			gpios = <&gpio1 23 GPIO_ACTIVE_LOW>;
			label = "Blue LED";
		};
		red_led: led_1 {
			gpios = <&gpio1 22 GPIO_ACTIVE_LOW>;
			label = "Red LED";
		};
		green_led: led_2 {
			gpios = <&gpio1 24 GPIO_ACTIVE_LOW>;
			label = "Green LED";
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		pwm_led0: pwm_led_0 { pwms = <&pwm20 0 PWM_MSEC(1) PWM_POLARITY_INVERTED>; };
		pwm_led1: pwm_led_1 { pwms = <&pwm20 1 PWM_MSEC(1) PWM_POLARITY_INVERTED>; };
		pwm_led2: pwm_led_2 { pwms = <&pwm20 2 PWM_MSEC(1) PWM_POLARITY_INVERTED>; };
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio0 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "User button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	power_en: power-en {
		compatible = "regulator-fixed";
		regulator-name = "sensor-power-enable";
		enable-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
	};

	pmic_i2c: pmic-i2c {
		compatible = "gpio-i2c";
		#address-cells = <1>;
		#size-cells = <0>;
		sda-gpios = <&gpio1 18 GPIO_ACTIVE_HIGH>;
		scl-gpios = <&gpio1 17 GPIO_ACTIVE_HIGH>;
		clock-frequency = <100000>;
		status = "okay";

		pmic: npm1300@6b {
			compatible = "nordic,npm1300";
			reg = <0x6b>;

			pmic_charger: charger {
				compatible = "nordic,npm1300-charger";
				term-microvolt = <4200000>;
				term-warm-microvolt = <4000000>;
				current-microamp = <150000>;
				dischg-limit-microamp = <1000000>;
				vbus-limit-microamp = <500000>;
				thermistor-ohms = <10000>;
				thermistor-beta = <3380>;
				charging-enable;
			};

			regulators {
				compatible = "nordic,npm1300-regulator";

				imu_vdd: LDO1 {
					regulator-init-microvolt = <3300000>;
					regulator-min-microvolt = <3300000>;
					regulator-max-microvolt = <3300000>;
					regulator-initial-mode = <NPM13XX_LDSW_MODE_LDO>;
					regulator-boot-on;
				};
			};
		};
	};

	aliases {
		led0 = &blue_led;
		led1 = &red_led;
		led2 = &green_led;
		pwm-led0 = &pwm_led0;
		pwm-led1 = &pwm_led1;
		pwm-led2 = &pwm_led2;
		sw0 = &button0;
		watchdog0 = &wdt31;
	};
};

&uart20 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart20_default>;
	pinctrl-1 = <&uart20_sleep>;
	pinctrl-names = "default", "sleep";
};

&uart21 {
	current-speed = <115200>;
	pinctrl-0 = <&uart21_default>;
	pinctrl-1 = <&uart21_sleep>;
	pinctrl-names = "default", "sleep";
};

&i2c22 {
	status = "okay";
	pinctrl-0 = <&i2c22_default>;
	pinctrl-1 = <&i2c22_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_FAST>;
	zephyr,concat-buf-size = <1023>;
	zephyr,flash-buf-max-size = <1023>;
};

&i2c30 {
	pinctrl-0 = <&i2c30_default>;
	pinctrl-1 = <&i2c30_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_FAST>;
	zephyr,concat-buf-size = <1023>;
	zephyr,flash-buf-max-size = <1023>;
};

&spi00 {
	pinctrl-0 = <&spi00_default>;
	pinctrl-1 = <&spi00_sleep>;
	pinctrl-names = "default", "sleep";
};

&spi23 {
	pinctrl-0 = <&spi23_default>;
	pinctrl-1 = <&spi23_sleep>;
	pinctrl-names = "default", "sleep";
};

&pwm20 {
	status = "okay";
	pinctrl-0 = <&pwm20_default>;
	pinctrl-1 = <&pwm20_sleep>;
	pinctrl-names = "default", "sleep";
};

&wdt31 {
	status = "okay";
};

