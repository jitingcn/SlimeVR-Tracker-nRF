# This board variant is targeted promico stack with the SM-ICM45686-AK09940A
# where ICM is on SPI, AK is on I2C, external clock disabled

CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

CONFIG_SLIMEVR_USB_DEVICE_MANUFACTURER="SlimeVR"
CONFIG_SLIMEVR_USB_DEVICE_PRODUCT="SlimeNRF Tracker ProMicro"

CONFIG_BATTERY_USE_REG_LDO_MAPPING=y
CONFIG_SENSOR_ROTATION_270=y

# Sensor driver whitelist (fixed BOM: ICM45686 + AK09940)
CONFIG_SENSOR_IMU_DRIVERS_MINIMAL=y
CONFIG_SENSOR_DRV_ICM45686=y
CONFIG_SENSOR_MAG_DRIVERS_MINIMAL=y
CONFIG_SENSOR_DRV_AK09940=y

#generate for adafruit uf2 bootloader flashing
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_BUILD_OUTPUT_UF2_FAMILY_ID="0xADA52840"
CONFIG_FLASH_LOAD_OFFSET=0x1000
